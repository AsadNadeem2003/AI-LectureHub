# ==========================================
# Caddy Production Reverse Proxy Config
# ==========================================

{
    email asadnadeem.aws@gmail.com
}

# 1. Automated HTTPS with Let's Encrypt / ZeroSSL for free public domains
3.89.86.157.sslip.io, 3.89.86.157.nip.io {
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend:5000
    }

    handle /uploads/* {
        reverse_proxy backend:5000
    }

    handle /ai/* {
        uri strip_prefix /ai
        reverse_proxy ai_service:8001
    }

    handle {
        reverse_proxy frontend:3000
    }
}

# 2. Raw IP HTTP access fallback
http://3.89.86.157 {
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend:5000
    }

    handle /uploads/* {
        reverse_proxy backend:5000
    }

    handle /ai/* {
        uri strip_prefix /ai
        reverse_proxy ai_service:8001
    }

    handle {
        reverse_proxy frontend:3000
    }
}
