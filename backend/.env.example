# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Database (Supabase PostgreSQL) ─────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_lecturehub?schema=public

# ── JWT Secret ─────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ── Redis (BullMQ task queue) ──────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Cloudinary (File & Media CDN) ──────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Resend (Transactional Email) ───────────────────────
RESEND_API_KEY=re_123456789
INVITE_FROM_EMAIL=onboarding@yourdomain.com

# ── AI Microservice URL ───────────────────────────────
AI_MICROSERVICE_URL=http://127.0.0.1:8000
